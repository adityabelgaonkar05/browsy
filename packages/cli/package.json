{
  "name": "@adityabelgaonkar/browsy",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Connect terminal MCP agents to your existing Chrome session locally.",
  "type": "module",
  "bin": {
    "browsy": "./dist/index.js",
    "agent-native": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabelgaonkar05/browsy.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/adityabelgaonkar05/browsy#readme",
  "bugs": {
    "url": "https://github.com/adityabelgaonkar05/browsy/issues"
  },
  "keywords": [
    "chrome",
    "mcp",
    "browser",
    "agents",
    "native-messaging"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-cli.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@agent-native/mcp": "workspace:*",
    "@agent-native/native-bridge": "workspace:*",
    "@agent-native/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "~5.9.3"
  }
}
